{%- comment -%}
  amatora-add-to-cart.liquid
  ----------------------------------------------------------------------
  Lógica del botón "Agregar al carrito" — un listener delegado para toda
  la página. amatora.js queda intacto.

  Renderízalo UNA sola vez en layout/theme.liquid, antes de </body>:
    {% render 'amatora-add-to-cart' %}

  Contrato del HTML:
    <button class="btn-primary-amatora"
            data-add-to-cart
            data-variant-id="{{ variant.id }}"
            data-quantity="1">      {# opcional, default 1 #}
      <span class="btn-label">Agregar al carrito</span>
    </button>

  Qué hace:
    - intercepta clicks en cualquier [data-add-to-cart] del documento
      (incluye HTML inyectado por AJAX / Section Rendering API)
    - setea data-state="loading" ANTES del fetch → amatora.css pinta el spinner
    - POST a /cart/add pidiendo las secciones del carrito del theme
    - si el theme tiene <cart-drawer> o <cart-notification> (Dawn y
      derivados), llama a renderContents() → el drawer se abre con el ítem
      nuevo y el contador se actualiza, igual que el botón nativo del PDP
    - éxito → data-state="success" por SUCCESS_HOLD_MS, vuelve a idle
    - error → data-state="error", se limpia en el siguiente click
    - dispatcha eventos en `document`: amatora:cart:added | amatora:cart:error

  Themes sin <cart-drawer>/<cart-notification>: escucha amatora:cart:added
  y abre tu drawer ahí. `detail.item` es la respuesta de /cart/add.

  Se desactiva la apertura automática desde el customizer:
  Configuraciones Amatora → Carrito → "Abrir el carrito al agregar".
{%- endcomment -%}
<script>
(() => {
  if (window.__amatoraAddToCartReady) return;
  window.__amatoraAddToCartReady = true;

  const SUCCESS_HOLD_MS = 1500;
  const addUrl = (window.routes && window.routes.cart_add_url) || '/cart/add';

  const openDrawer = () => {
    const cfg = window.AmatoraConfig || {};
    return cfg.cartOpenDrawer !== false;
  };

  // Dawn y derivados exponen getSectionsToRender() + renderContents()
  const getThemeCart = () =>
    document.querySelector('cart-notification') || document.querySelector('cart-drawer');

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-add-to-cart]');
    if (!btn) return;

    const variantId = btn.dataset.variantId;
    if (!variantId) return;

    e.preventDefault();
    if (btn.dataset.state === 'loading') return;
    btn.dataset.state = 'loading';

    const cart = openDrawer() ? getThemeCart() : null;
    const canRender = cart
      && typeof cart.getSectionsToRender === 'function'
      && typeof cart.renderContents === 'function';

    const body = new FormData();
    body.append('id', variantId);
    body.append('quantity', btn.dataset.quantity || '1');
    if (canRender) {
      body.append('sections', cart.getSectionsToRender().map((s) => s.id).join(','));
      body.append('sections_url', window.location.pathname);
      if (typeof cart.setActiveElement === 'function') cart.setActiveElement(document.activeElement);
    }

    try {
      const res = await fetch(addUrl, {
        method: 'POST',
        headers: {
          'Accept': 'application/javascript',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body
      });
      const json = await res.json();

      // Shopify responde 422 + { status, message, description } si no hay stock, etc.
      if (!res.ok || json.status) {
        throw new Error(json.description || json.message || ('cart/add ' + res.status));
      }

      btn.dataset.state = 'success';

      if (canRender) cart.renderContents(json);

      document.dispatchEvent(new CustomEvent('amatora:cart:added', {
        detail: { item: json, button: btn, cart: cart || null }
      }));

      setTimeout(() => {
        if (btn.dataset.state === 'success') btn.dataset.state = 'idle';
      }, SUCCESS_HOLD_MS);

    } catch (err) {
      btn.dataset.state = 'error';
      document.dispatchEvent(new CustomEvent('amatora:cart:error', {
        detail: { error: err, button: btn }
      }));
      console.warn('[amatora-add-to-cart]', err);
    }
  });
})();
</script>
