{
  "name": "Amatora — Diseño base",
  "settings": [
    { "type": "header", "content": "Colores" },
    {
      "type": "color",
      "id": "am_primary",
      "label": "Color primario",
      "default": "#004a3b"
    },
    {
      "type": "color",
      "id": "am_primary_hover",
      "label": "Color primario (hover)",
      "default": "#003a2e"
    },
    {
      "type": "color",
      "id": "am_secondary",
      "label": "Color secundario",
      "default": "#9c6b3f"
    },
    {
      "type": "color",
      "id": "am_secondary_hover",
      "label": "Color secundario (hover)",
      "default": "#7d5532"
    },
    {
      "type": "color",
      "id": "am_accent",
      "label": "Color de acento",
      "default": "#FFF8EC"
    },
    {
      "type": "color",
      "id": "am_text",
      "label": "Color de texto principal",
      "default": "#0c2330"
    },
    {
      "type": "color",
      "id": "am_bg_light",
      "label": "Fondo claro",
      "default": "#FAF7F0"
    },

    { "type": "header", "content": "Tipografía" },
    {
      "type": "font_picker",
      "id": "am_font_heading",
      "label": "Fuente de títulos",
      "default": "playfair_display_n4"
    },
    {
      "type": "font_picker",
      "id": "am_font_body",
      "label": "Fuente de cuerpo",
      "default": "helvetica_n4"
    },

    { "type": "header", "content": "Botones" },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Botón primario — fondo",
      "info": "Si lo dejas vacío, usa el color primario.",
      "default": "#004a3b"
    },
    {
      "type": "color",
      "id": "btn_primary_fg",
      "label": "Botón primario — texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Radio del botón (px)",
      "min": 0, "max": 40, "step": 2, "default": 30,
      "info": "0 = cuadrado, 30 = pill."
    },
    {
      "type": "range",
      "id": "btn_fs",
      "label": "Tamaño de fuente del botón (px)",
      "min": 12, "max": 22, "step": 1, "default": 16
    },

    { "type": "header", "content": "Sliders / Carruseles" },
    {
      "type": "select",
      "id": "slider_dots_style",
      "label": "Estilo de los puntos (dots)",
      "options": [
        { "value": "bar",                "label": "Barras" },
        { "value": "circle",             "label": "Círculos" },
        { "value": "progress",           "label": "Barra de progreso" },
        { "value": "progress-segmented", "label": "Progreso segmentado (stories)" }
      ],
      "default": "bar"
    },
    {
      "type": "select",
      "id": "slider_arrows_pos",
      "label": "Posición de las flechas",
      "options": [
        { "value": "header", "label": "En el header (arriba)" },
        { "value": "sides",  "label": "Flotantes a los lados" }
      ],
      "default": "header"
    },
    {
      "type": "checkbox",
      "id": "slider_show_arrows",
      "label": "Mostrar flechas por defecto",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "slider_show_dots",
      "label": "Mostrar dots por defecto",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_gap",
      "label": "Espacio entre slides (px)",
      "min": 0, "max": 40, "step": 2, "default": 16
    },
    {
      "type": "range",
      "id": "slider_arrow_size",
      "label": "Tamaño de las flechas (px)",
      "min": 28, "max": 60, "step": 2, "default": 44
    },
    {
      "type": "image_picker",
      "id": "slider_arrow_icon",
      "label": "Icono personalizado de las flechas",
      "info": "Subí un SVG o PNG cuadrado (~24×24) apuntando hacia la derecha. La flecha 'Anterior' se voltea automáticamente. Si lo dejás vacío, se usa el chevron por defecto."
    },
    {
      "type": "select",
      "id": "slider_transition_speed",
      "label": "Velocidad de transición",
      "options": [
        { "value": "smooth", "label": "Suave (premium)" },
        { "value": "normal", "label": "Normal" },
        { "value": "fast",   "label": "Rápida" }
      ],
      "default": "smooth"
    },

    { "type": "header", "content": "Comportamiento del carrito" },
    {
      "type": "select",
      "id": "add_to_cart_with_variants",
      "label": "Productos con variantes",
      "info": "Qué hace el botón Agregar al carrito cuando el producto tiene más de una variante.",
      "options": [
        { "value": "link_to_product",      "label": "Mandar a la página del producto" },
        { "value": "show_variants_inline", "label": "Mostrar variantes en un drawer" }
      ],
      "default": "link_to_product"
    }
  ]
}
