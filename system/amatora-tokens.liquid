{%- comment -%}
  amatora-tokens.liquid
  ----------------------------------------------------------------------
  Desde v0.7.0: este snippet NO inyecta colores ni dimensiones de botones.

  Source of truth de la paleta + forma de botones = assets/amatora.css
  (sección 2 — CONFIGURACIÓN DEL PROYECTO). Para cambiar la marca o el
  radius de los botones, editá ese archivo directamente.

  Lo que SÍ hace este snippet:
    - Carga las fuentes elegidas en el customizer (font_face)
    - Inyecta --am-font-heading / --am-font-body en :root
    - Inyecta los settings de slider (--sl-gap, --sl-arrow-size, --sl-transition)
    - Setea window.AmatoraConfig con los defaults de slider que no son CSS vars

  Renderizá UNA sola vez en layout/theme.liquid, dentro del <head>,
  inmediatamente DESPUÉS de cargar amatora.css:

    {{ 'amatora.css' | asset_url | stylesheet_tag }}
    {% render 'amatora-tokens' %}
{%- endcomment -%}

<style>
  {%- comment -%}
    font_face devuelve @font-face { ... } como texto crudo, NO envuelto
    en <style>. Tiene que vivir dentro de este mismo bloque <style>; si lo
    dejás suelto en el head, el parser lo empuja al <body> como texto.
  {%- endcomment -%}
  {%- if settings.am_font_heading != blank %}
  {{ settings.am_font_heading | font_face: font_display: 'swap' }}
  {%- endif %}
  {%- if settings.am_font_body != blank %}
  {{ settings.am_font_body | font_face: font_display: 'swap' }}
  {%- endif %}

  :root {
    {%- if settings.am_font_heading != blank %}
    --am-font-heading: {{ settings.am_font_heading.family }}, {{ settings.am_font_heading.fallback_families }};
    {%- endif %}
    {%- if settings.am_font_body != blank %}
    --am-font-body:    {{ settings.am_font_body.family }},    {{ settings.am_font_body.fallback_families }};
    {%- endif %}

    {%- comment -%} Sliders — defaults globales del panel {%- endcomment -%}
    {%- if settings.slider_gap %}
    --sl-gap:        {{ settings.slider_gap }}px;
    {%- endif %}
    {%- if settings.slider_arrow_size %}
    --sl-arrow-size: {{ settings.slider_arrow_size }}px;
    {%- endif %}
    {%- case settings.slider_transition_speed -%}
    {%- when 'smooth' %}
    --sl-transition: 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    {%- when 'normal' %}
    --sl-transition: 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    {%- when 'fast' %}
    --sl-transition: 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    {%- endcase -%}
  }
</style>

{%- comment -%}
  Defaults globales del slider que NO son CSS variables (estilo de dots,
  posición de flechas, mostrar/ocultar). amatora.js los lee al inicializar
  cada [data-amatora-slider]. Si la sección define data-* propios, esos
  ganan (data-attribute > opts > AmatoraConfig > hardcoded).
{%- endcomment -%}
<script>
  window.AmatoraConfig = window.AmatoraConfig || {};
  window.AmatoraConfig.sliderDotsStyle  = {{ settings.slider_dots_style  | default: 'bar'    | json }};
  window.AmatoraConfig.sliderArrowsPos  = {{ settings.slider_arrows_pos  | default: 'header' | json }};
  window.AmatoraConfig.sliderShowArrows = {{ settings.slider_show_arrows | default: true     | json }};
  window.AmatoraConfig.sliderShowDots   = {{ settings.slider_show_dots   | default: true     | json }};
  {%- if settings.slider_arrow_icon != blank %}
  window.AmatoraConfig.sliderArrowIcon  = {{ settings.slider_arrow_icon | image_url: width: 64 | json }};
  {%- endif %}
</script>
