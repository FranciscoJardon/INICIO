{%- comment -%}
  amatora-tokens.liquid
  ----------------------------------------------------------------------
  Puente entre el panel "Configuraciones Amatora" del customizer y el CSS.

  Regla única de precedencia:
    customizer (este snippet) > assets/amatora.css sección 2 (defaults de fábrica)

  Lo que hace:
    - Carga las fuentes elegidas en el customizer (font_face) e inyecta
      --am-font-heading / --am-font-body
    - Inyecta los colores del panel como --am-color-* / --am-text-* / --am-bg-* / --am-border
    - Inyecta la forma de los botones (--btn-radius, --btn-fs, --btn-fw, --btn-py, --btn-px)
    - Inyecta los settings de slider (--sl-gap, --sl-arrow-size, --sl-transition)
    - Setea window.AmatoraConfig con los defaults que no son CSS vars
      (dots, flechas, icono custom, comportamiento del carrito)

  Renderízalo UNA sola vez en layout/theme.liquid, dentro del <head>,
  inmediatamente DESPUÉS de amatora.css (así sus :root ganan):

    {{ 'amatora.css' | asset_url | stylesheet_tag }}
    {% render 'amatora-tokens' %}
{%- endcomment -%}

<style>
  {%- comment -%}
    font_face devuelve @font-face { ... } como texto crudo, NO envuelto
    en <style>. Tiene que vivir dentro de este mismo bloque.
  {%- endcomment -%}
  {%- if settings.am_font_heading != blank %}
  {{ settings.am_font_heading | font_face: font_display: 'swap' }}
  {%- endif %}
  {%- if settings.am_font_body != blank %}
  {{ settings.am_font_body | font_face: font_display: 'swap' }}
  {%- endif %}

  :root {
    {%- if settings.am_font_heading != blank %}
    --am-font-heading: {{ settings.am_font_heading.family }}, {{ settings.am_font_heading.fallback_families }};
    {%- endif %}
    {%- if settings.am_font_body != blank %}
    --am-font-body: {{ settings.am_font_body.family }}, {{ settings.am_font_body.fallback_families }};
    {%- endif %}

    {%- comment -%} Colores — solo si el merchant los definió {%- endcomment -%}
    {%- if settings.am_color_primary != blank %}
    --am-color-primary: {{ settings.am_color_primary }};
    {%- endif %}
    {%- if settings.am_color_primary_hover != blank %}
    --am-color-primary-hover: {{ settings.am_color_primary_hover }};
    {%- endif %}
    {%- if settings.am_color_secondary != blank %}
    --am-color-secondary: {{ settings.am_color_secondary }};
    {%- endif %}
    {%- if settings.am_color_secondary_hover != blank %}
    --am-color-secondary-hover: {{ settings.am_color_secondary_hover }};
    {%- endif %}
    {%- if settings.am_text_primary != blank %}
    --am-text-primary: {{ settings.am_text_primary }};
    {%- endif %}
    {%- if settings.am_text_secondary != blank %}
    --am-text-secondary: {{ settings.am_text_secondary }};
    {%- endif %}
    {%- if settings.am_bg_light != blank %}
    --am-bg-light: {{ settings.am_bg_light }};
    {%- endif %}
    {%- if settings.am_bg_warm != blank %}
    --am-bg-warm: {{ settings.am_bg_warm }};
    {%- endif %}
    {%- if settings.am_border != blank %}
    --am-border: {{ settings.am_border }};
    {%- endif %}

    {%- comment -%} Botones — forma y tamaño global {%- endcomment -%}
    {%- if settings.am_btn_radius != blank %}
    --btn-radius: {{ settings.am_btn_radius }}px;
    {%- endif %}
    {%- if settings.am_btn_fs != blank %}
    --btn-fs: {{ settings.am_btn_fs }}px;
    {%- endif %}
    {%- if settings.am_btn_fw != blank %}
    --btn-fw: {{ settings.am_btn_fw }};
    {%- endif %}
    {%- if settings.am_btn_py != blank %}
    --btn-py: {{ settings.am_btn_py }}px;
    {%- endif %}
    {%- if settings.am_btn_px != blank %}
    --btn-px: {{ settings.am_btn_px }}px;
    {%- endif %}

    {%- comment -%} Sliders — defaults globales {%- endcomment -%}
    {%- if settings.slider_gap != blank %}
    --sl-gap: {{ settings.slider_gap }}px;
    {%- endif %}
    {%- if settings.slider_arrow_size != blank %}
    --sl-arrow-size: {{ settings.slider_arrow_size }}px;
    {%- endif %}
    {%- case settings.slider_transition_speed -%}
    {%- when 'smooth' %}
    --sl-transition: 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    {%- when 'normal' %}
    --sl-transition: 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    {%- when 'fast' %}
    --sl-transition: 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    {%- endcase -%}
  }
</style>

{%- comment -%}
  Defaults que no son CSS variables. amatora.js y amatora-add-to-cart.liquid
  los leen. Si una sección define data-* propios, esos ganan
  (data-attribute > opts > AmatoraConfig > hardcoded).
{%- endcomment -%}
<script>
  window.AmatoraConfig = window.AmatoraConfig || {};
  window.AmatoraConfig.sliderDotsStyle  = {{ settings.slider_dots_style  | default: 'bar'    | json }};
  window.AmatoraConfig.sliderArrowsPos  = {{ settings.slider_arrows_pos  | default: 'header' | json }};
  window.AmatoraConfig.sliderShowArrows = {{ settings.slider_show_arrows | default: true, allow_false: true | json }};
  window.AmatoraConfig.sliderShowDots   = {{ settings.slider_show_dots   | default: true, allow_false: true | json }};
  window.AmatoraConfig.cartOpenDrawer   = {{ settings.am_cart_open_drawer | default: true, allow_false: true | json }};
  window.AmatoraConfig.cartVariants     = {{ settings.add_to_cart_with_variants | default: 'link_to_product' | json }};
  {%- if settings.slider_arrow_icon != blank %}
  window.AmatoraConfig.sliderArrowIcon  = {{ settings.slider_arrow_icon | image_url: width: 64 | json }};
  {%- endif %}
</script>
