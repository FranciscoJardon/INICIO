{
  "name": "Configuraciones Amatora",
  "settings": [
    { "type": "paragraph", "content": "Panel del sistema Amatora. Todo lo que definas aquí manda sobre los valores de fábrica de assets/amatora.css y lo leen todas las secciones -amatora: colores, tipografía, botones, sliders y carrito." },

    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "am_color_primary",         "label": "Primario",              "default": "#004a3b", "info": "Botones principales, acentos, dots activos." },
    { "type": "color", "id": "am_color_primary_hover",   "label": "Primario (hover)",      "default": "#004a3b" },
    { "type": "color", "id": "am_color_secondary",       "label": "Secundario",            "default": "#7db38e" },
    { "type": "color", "id": "am_color_secondary_hover", "label": "Secundario (hover)",    "default": "#7db38e" },
    { "type": "color", "id": "am_text_primary",          "label": "Texto principal",       "default": "#004a3b" },
    { "type": "color", "id": "am_text_secondary",        "label": "Texto secundario",      "default": "#004a3b" },
    { "type": "color", "id": "am_bg_light",              "label": "Fondo claro",           "default": "#D1E0EF" },
    { "type": "color", "id": "am_bg_warm",               "label": "Fondo cálido",          "default": "#F6F4F1" },
    { "type": "color", "id": "am_border",                "label": "Bordes",                "default": "#D0D0D0" },

    { "type": "header", "content": "Tipografía" },
    {
      "type": "font_picker",
      "id": "am_font_heading",
      "label": "Fuente de títulos",
      "default": "playfair_display_n4"
    },
    {
      "type": "font_picker",
      "id": "am_font_body",
      "label": "Fuente de cuerpo",
      "default": "assistant_n4"
    },

    { "type": "header", "content": "Botones" },
    { "type": "paragraph", "content": "Aplica a todos los .btn-primary-amatora y .btn-secondary-amatora. Los .btn-block-amatora conservan su esquina signature." },
    { "type": "range", "id": "am_btn_radius", "label": "Radio de esquinas",  "min": 0,  "max": 40, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "am_btn_fs",     "label": "Tamaño de letra",    "min": 12, "max": 20, "step": 1, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "am_btn_fw",
      "label": "Peso de letra",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    { "type": "range", "id": "am_btn_py",     "label": "Padding vertical",   "min": 8,  "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "am_btn_px",     "label": "Padding horizontal", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Sliders / Carruseles" },
    {
      "type": "select",
      "id": "slider_dots_style",
      "label": "Estilo de los puntos (dots)",
      "options": [
        { "value": "bar",    "label": "Barras" },
        { "value": "circle", "label": "Círculos" }
      ],
      "default": "bar"
    },
    {
      "type": "select",
      "id": "slider_arrows_pos",
      "label": "Posición de las flechas",
      "options": [
        { "value": "header", "label": "En el header (arriba)" },
        { "value": "sides",  "label": "Flotantes a los lados" }
      ],
      "default": "header"
    },
    { "type": "checkbox", "id": "slider_show_arrows", "label": "Mostrar flechas por defecto", "default": true },
    { "type": "checkbox", "id": "slider_show_dots",   "label": "Mostrar dots por defecto",    "default": true },
    { "type": "range", "id": "slider_gap",        "label": "Espacio entre slides", "min": 0,  "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "slider_arrow_size", "label": "Tamaño de las flechas", "min": 28, "max": 60, "step": 2, "unit": "px", "default": 44 },
    {
      "type": "image_picker",
      "id": "slider_arrow_icon",
      "label": "Icono personalizado de las flechas",
      "info": "SVG o PNG cuadrado (~24×24) apuntando a la derecha. La flecha 'Anterior' se voltea sola. Vacío = chevron por defecto."
    },
    {
      "type": "select",
      "id": "slider_transition_speed",
      "label": "Velocidad de transición",
      "options": [
        { "value": "smooth", "label": "Suave (premium)" },
        { "value": "normal", "label": "Normal" },
        { "value": "fast",   "label": "Rápida" }
      ],
      "default": "smooth"
    },

    { "type": "header", "content": "Carrito" },
    {
      "type": "checkbox",
      "id": "am_cart_open_drawer",
      "label": "Abrir el carrito al agregar un producto",
      "default": true,
      "info": "Usa el cart drawer o la notificación del theme (Dawn y derivados). Si el theme no tiene, el botón emite el evento amatora:cart:added para que lo enganches a tu drawer."
    },
    {
      "type": "select",
      "id": "add_to_cart_with_variants",
      "label": "Productos con variantes",
      "info": "Qué hace el botón Agregar al carrito cuando el producto tiene más de una variante.",
      "options": [
        { "value": "link_to_product",      "label": "Mandar a la página del producto" },
        { "value": "show_variants_inline", "label": "Mostrar variantes en un drawer" }
      ],
      "default": "link_to_product"
    }
  ]
}
