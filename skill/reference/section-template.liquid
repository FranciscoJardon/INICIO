{%- comment -%}
  ============================================================
  PLANTILLA BASE — Sección Amatora
  ============================================================
  Copia este archivo a sections/{nombre}-amatora.liquid y
  reemplaza:
    - "nombre"        → identificador kebab-case (ej: "banner-hero")
    - "Nombre Amatora"→ nombre visible en el customizer
    - El contenido HTML, settings y blocks según el caso

  Cumple los 3 mandatos:
   1. Slider con [data-amatora-slider] (no Swiper/Slick)
   2. Utility classes -amatora + tokens --am-*
   3. Imágenes con image_url + width/height + loading correcto
  ============================================================
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
{%- liquid
  assign sid = 'nombre-' | append: section.id
  assign first = section.blocks.first
  assign is_single = false
  if section.blocks.size == 1
    assign is_single = true
  endif
-%}

{%- comment -%} MANDATE 3 — Preload del LCP (solo si esta sección está above-the-fold) {%- endcomment -%}
{%- if first.settings.img != blank -%}
  <link rel="preload" as="image" fetchpriority="high"
        href="{{ first.settings.img | image_url: width: 1920 }}">
{%- endif -%}

{%- comment -%} ⚠️ Root tag <div>, NO <section> — Shopify ya lo envuelve en <section> via "tag" del schema {%- endcomment -%}
<div id="{{ sid }}" class="nombre-am" aria-label="{{ section.settings.aria_label | default: 'Sección' | escape }}">

  <div class="container-amatora px-4-amatora md:px-6-amatora py-12-amatora md:py-16-amatora">

    {%- if section.settings.heading != blank -%}
      <h2 class="nombre-am__title text-2xl-amatora md:text-4xl-amatora font-bold-amatora text-center-amatora mb-8-amatora">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="nombre-am__wrap"
      {%- unless is_single -%}
        data-amatora-slider
        data-variant="default"
        data-visible-desktop="{{ section.settings.visible_desktop | default: 3 }}"
        data-visible-tablet="{{ section.settings.visible_tablet | default: 2 }}"
        data-visible-mobile="{{ section.settings.visible_mobile | default: 1.2 }}"
        data-gap="16"
        data-arrows-pos="header"
        data-dots-style="bar"
        data-loop="false"
      {%- endunless -%}>

      {%- for block in section.blocks -%}
        <div class="nombre-am__slide" {{ block.shopify_attributes }}>

          {%- if block.settings.img != blank -%}
            {%- comment -%} Imagen móvil (block.settings.img2) {%- endcomment -%}
            {%- if block.settings.img2 != blank -%}
              <img
                src="{{ block.settings.img2 | image_url: width: 800 }}"
                class="nombre-am__media nombre-am__media--mob w-full-amatora h-auto-amatora"
                width="{{ block.settings.img2.width }}"
                height="{{ block.settings.img2.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
                decoding="async"
                alt="{{ block.settings.alt_text | default: block.settings.heading | default: 'Imagen' | escape }}">
            {%- endif -%}

            {%- comment -%} Imagen desktop (block.settings.img) {%- endcomment -%}
            <img
              src="{{ block.settings.img | image_url: width: 1200 }}"
              class="nombre-am__media nombre-am__media--desk w-full-amatora h-auto-amatora"
              width="{{ block.settings.img.width }}"
              height="{{ block.settings.img.height }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {% if forloop.first %}fetchpriority="high"{% endif %}
              decoding="async"
              alt="{{ block.settings.alt_text | default: block.settings.heading | default: 'Imagen' | escape }}">
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="nombre-am__heading text-lg-amatora md:text-xl-amatora font-semibold-amatora mt-4-amatora">
              {{ block.settings.heading }}
            </h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="nombre-am__text text-base-amatora text-muted-amatora mt-2-amatora">
              {{ block.settings.text }}
            </p>
          {%- endif -%}

          {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
            <div class="flex-amatora justify-center-amatora mt-6-amatora">
              <a href="{{ block.settings.cta_link }}" class="btn-primary-amatora btn-block-amatora">
                <span class="btn-label">{{ block.settings.cta_text }}</span>
              </a>
            </div>
          {%- endif -%}

        </div>
      {%- endfor -%}

    </div>
  </div>

</div>

<style>
  /* Scope obligatorio: #{{ sid }} */
  /* Solo CSS no-utility: positioning, transitions, aspect-ratio, dynamic settings */

  #{{ sid }} .nombre-am__media--mob { display: block; }
  #{{ sid }} .nombre-am__media--desk { display: none; }

  @media (min-width: 768px) {
    #{{ sid }} .nombre-am__media--mob { display: none; }
    #{{ sid }} .nombre-am__media--desk { display: block; }
  }

  #{{ sid }} .nombre-am__media {
    object-fit: cover;
    aspect-ratio: 4/3;
    border-radius: 12px;
  }

  {%- if section.settings.bg_color != blank -%}
    #{{ sid }} { background: {{ section.settings.bg_color }}; }
  {%- endif -%}
</style>

{%- endif -%}

{% schema %}
{
  "name": "Nombre Amatora",
  "class": "section-nombre-amatora",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "visible_desktop",
      "label": "Slides visibles (desktop)",
      "min": 1, "max": 6, "step": 1, "default": 3
    },
    {
      "type": "range",
      "id": "visible_tablet",
      "label": "Slides visibles (tablet)",
      "min": 1, "max": 4, "step": 1, "default": 2
    },
    {
      "type": "text",
      "id": "visible_mobile",
      "label": "Slides visibles (móvil)",
      "default": "1.2",
      "info": "Permite decimales (ej: 1.2 muestra 1 entero + asomo del siguiente)"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria-label (accesibilidad)"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Imagen desktop (1920×800 recomendado)"
        },
        {
          "type": "image_picker",
          "id": "img2",
          "label": "Imagen móvil (1080×1400 recomendado)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo (SEO)",
          "info": "Descripción para lectores de pantalla y SEO"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Link del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nombre Amatora",
      "category": "Amatora",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
