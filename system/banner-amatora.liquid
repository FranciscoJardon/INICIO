{%- if section.blocks.size > 0 -%}
{%- liquid
  assign sid      = 'banner-' | append: section.id
  assign autoplay = section.settings.autoplay | times: 1000
-%}

<div id="{{ sid }}" aria-label="{{ section.settings.aria_label | default: 'Banner' | escape }}">

  {%- comment -%}
    MANDATO 1: slider con [data-amatora-slider].
    - Con 1 solo slide, amatora.js lo marca .is-static (sin flechas ni dots).
      No hace falta lógica Liquid de "single slide".
    - Las CSS vars inline (--sl-peek / --sl-gap) hacen que el layout ANTES
      de que corra el JS sea idéntico al final: la imagen LCP pinta apenas
      llega, sin esperar a amatora.js.
  {%- endcomment -%}
  <div class="banner-am__track"
       data-amatora-slider
       data-variant="banner"
       data-peek="0"
       data-gap="0"
       data-arrows="{{ section.settings.show_arrows }}"
       data-arrows-pos="sides"
       data-dots="{{ section.settings.show_dots }}"
       data-dots-style="{{ section.settings.dots_style }}"
       data-accent="{{ section.settings.accent_color }}"
       data-autoplay="{{ autoplay }}"
       data-loop="true"
       style="--sl-peek: 0px; --sl-gap: 0px;">

    {%- for block in section.blocks -%}
      {%- liquid
        assign alt = block.settings.alt_text | default: shop.name
        assign has_cta = false
        if block.settings.cta_text != blank
          assign has_cta = true
        endif
        assign wrap_in_link = false
        if block.settings.url != blank and has_cta == false
          assign wrap_in_link = true
        endif
      -%}
      <div class="relative-amatora w-full-amatora" {{ block.shopify_attributes }}>

        {%- if wrap_in_link -%}
          <a href="{{ block.settings.url }}" class="block-amatora w-full-amatora text-decoration-amatora" aria-label="{{ alt | escape }}">
        {%- endif -%}

        {%- if block.settings.formato == 'video' -%}
          {%- if block.settings.video != blank -%}
            <video class="block-amatora w-full-amatora h-auto-amatora object-cover-amatora"
                   autoplay muted loop playsinline
                   {% if forloop.first %}preload="metadata"{% else %}preload="none"{% endif %}
                   {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 1600 }}"{% endif %}>
              {%- for src in block.settings.video.sources -%}
                <source src="{{ src.url }}" type="{{ src.mime_type }}">
              {%- endfor -%}
            </video>
          {%- endif -%}

        {%- elsif block.settings.img != blank -%}
          {%- comment -%}
            MANDATO 3: image_url + image_tag. Shopify genera srcset, width/height
            y el formato (WebP/AVIF) solo. Primer slide = LCP: eager + high
            (+ preload si no hay imagen móvil aparte). El resto lazy.
          {%- endcomment -%}
          <picture>
            {%- if block.settings.img2 != blank -%}
              <source media="(max-width: 767px)"
                      srcset="{{ block.settings.img2 | image_url: width: 750 }} 750w,
                              {{ block.settings.img2 | image_url: width: 1080 }} 1080w"
                      sizes="100vw"
                      width="{{ block.settings.img2.width }}"
                      height="{{ block.settings.img2.height }}">
            {%- endif -%}
            {%- if forloop.first and block.settings.img2 == blank -%}
              {{ block.settings.img | image_url: width: 2040 | image_tag: class: 'block-amatora w-full-amatora h-auto-amatora object-cover-amatora', sizes: '100vw', alt: alt, loading: 'eager', fetchpriority: 'high', preload: true }}
            {%- elsif forloop.first -%}
              {{ block.settings.img | image_url: width: 2040 | image_tag: class: 'block-amatora w-full-amatora h-auto-amatora object-cover-amatora', sizes: '100vw', alt: alt, loading: 'eager', fetchpriority: 'high' }}
            {%- else -%}
              {{ block.settings.img | image_url: width: 2040 | image_tag: class: 'block-amatora w-full-amatora h-auto-amatora object-cover-amatora', sizes: '100vw', alt: alt, loading: 'lazy' }}
            {%- endif -%}
          </picture>
        {%- endif -%}

        {%- if wrap_in_link -%}
          </a>
        {%- endif -%}

        {%- comment -%}
          CTA opcional. Cuando hay cta_text NO envolvemos el media en <a>
          (sería un link dentro de otro link); el botón es el único navegable.
        {%- endcomment -%}
        {%- if has_cta -%}
          <div class="banner-am__cta absolute-amatora left-0-amatora right-0-amatora z-1-amatora flex-amatora justify-center-amatora px-4-amatora">
            <a href="{{ block.settings.url | default: '#' }}" class="btn-primary-amatora btn-block-amatora">
              <span class="btn-label">{{ block.settings.cta_text }}</span>
            </a>
          </div>
        {%- endif -%}

      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  /* MANDATO 2: solo lo que NO existe como utility. Layout, posición y
     object-fit van como clases -amatora en el HTML. */
  #{{ sid }} .banner-am__track { --sl-radius: 0; }
  #{{ sid }} .slider-amatora__viewport { border-radius: 0; }

  /* Offset fuera de la escala */
  #{{ sid }} .banner-am__cta { bottom: 48px; }

  /* Dots flotantes al pie del banner (selector generado por el JS) */
  #{{ sid }} .slider-amatora__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 32px);
    max-width: 400px;
    z-index: 3;
    margin-top: 0;
  }

  {%- unless section.settings.show_arrows_mobile -%}
    @media (max-width: 767px) {
      #{{ sid }} .slider-amatora__arrows { display: none; }
    }
  {%- endunless -%}
</style>

{%- endif -%}

{% schema %}
{
  "name": "Banner Amatora",
  "class": "section-banner-amatora",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "General" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria label",
      "default": "Banner principal"
    },

    { "type": "header", "content": "Autoplay y navegación" },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Autoplay (segundos)",
      "min": 0, "max": 15, "step": 1, "default": 5,
      "info": "0 = desactivado"
    },
    { "type": "checkbox", "id": "show_arrows",        "label": "Mostrar flechas",          "default": true  },
    { "type": "checkbox", "id": "show_arrows_mobile", "label": "Mostrar flechas en móvil", "default": false },
    { "type": "checkbox", "id": "show_dots",          "label": "Mostrar indicadores",      "default": true  },
    {
      "type": "select",
      "id": "dots_style",
      "label": "Estilo de indicadores",
      "options": [
        { "value": "bar",    "label": "Barras" },
        { "value": "circle", "label": "Círculos" }
      ],
      "default": "bar"
    },
    { "type": "color", "id": "accent_color", "label": "Acento (dots)", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Media" },
        {
          "type": "select",
          "id": "formato",
          "label": "Formato",
          "options": [
            { "value": "image", "label": "Imagen" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "img",
          "label": "Imagen desktop",
          "info": "Recomendado: 2040×850px",
          "visible_if": "{{ block.settings.formato == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "img2",
          "label": "Imagen móvil (opcional)",
          "info": "Recomendado: 1080×1400px. Si la dejas vacía se usa la de desktop.",
          "visible_if": "{{ block.settings.formato == 'image' }}"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo (SEO)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.formato == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster del video",
          "visible_if": "{{ block.settings.formato == 'video' }}"
        },

        { "type": "header", "content": "Llamado a la acción (opcional)" },
        { "type": "text", "id": "cta_text", "label": "Texto del botón", "info": "Si está vacío, el banner entero linkea a la URL." },
        { "type": "url",  "id": "url",      "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    { "name": "Banner Amatora", "category": "Amatora", "blocks": [{ "type": "slide" }] }
  ]
}
{% endschema %}
