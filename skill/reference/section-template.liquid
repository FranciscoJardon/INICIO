{%- comment -%}
  ============================================================
  PLANTILLA BASE — Sección Amatora
  ============================================================
  Copia este archivo a sections/{nombre}-amatora.liquid y
  reemplaza:
    - "nombre"         → identificador kebab-case (ej: "productos-destacados")
    - "Nombre Amatora" → nombre visible en el customizer
    - El contenido HTML, settings y blocks según el caso

  Cumple los 4 mandatos:
   1. Slider con [data-amatora-slider] (no Swiper/Slick)
   2. Utilities -amatora + tokens --am-* (solo prefijo md:)
   3. Imágenes con image_url + image_tag
   4. Carrito con data-add-to-cart (si aplica)
  ============================================================
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
{%- liquid
  assign sid = 'nombre-' | append: section.id
  assign vis_lg = section.settings.visible_desktop | default: 3
  assign vis_md = section.settings.visible_tablet | default: 2
  assign vis_sm = section.settings.visible_mobile | default: '1.2'
-%}

{%- comment -%} Root <div>, NUNCA <section>: Shopify ya lo envuelve vía "tag" del schema {%- endcomment -%}
<div id="{{ sid }}" aria-label="{{ section.settings.aria_label | default: 'Sección' | escape }}">

  <div class="container-amatora px-4-amatora md:px-6-amatora py-12-amatora md:py-16-amatora">

    {%- if section.settings.heading != blank -%}
      <h2 class="text-2xl-amatora md:text-4xl-amatora font-bold-amatora text-center-amatora mb-8-amatora">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- comment -%}
      MANDATO 1. Las CSS vars inline repiten los data-visible-* para que el
      layout pre-init (antes de amatora.js) sea idéntico al final.
      Con 1 solo block, el JS marca .is-static: no hace falta lógica Liquid.
    {%- endcomment -%}
    <div data-amatora-slider
         data-visible-desktop="{{ vis_lg }}"
         data-visible-tablet="{{ vis_md }}"
         data-visible-mobile="{{ vis_sm }}"
         data-gap="16"
         data-arrows-pos="header"
         data-dots-style="bar"
         style="--sl-visible-lg: {{ vis_lg }}; --sl-visible-md: {{ vis_md }}; --sl-visible-sm: {{ vis_sm }}; --sl-gap: 16px;">

      {%- for block in section.blocks -%}
        {%- liquid
          assign alt = block.settings.alt_text | default: block.settings.heading | default: shop.name
          assign img_loading = 'lazy'
          if forloop.index <= 3
            assign img_loading = 'eager'
          endif
        -%}
        <div {{ block.shopify_attributes }}>

          {%- comment -%} MANDATO 3: una línea por imagen. Primeras 3 slides eager, resto lazy. {%- endcomment -%}
          {%- if block.settings.img != blank -%}
            {{ block.settings.img | image_url: width: 800 | image_tag: class: 'nombre-am__media w-full-amatora h-auto-amatora object-cover-amatora', sizes: '(min-width: 768px) 33vw, 85vw', alt: alt, loading: img_loading }}
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="text-lg-amatora md:text-xl-amatora font-semibold-amatora mt-4-amatora">
              {{ block.settings.heading }}
            </h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="text-base-amatora text-muted-amatora mt-2-amatora">
              {{ block.settings.text }}
            </p>
          {%- endif -%}

          {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
            <div class="flex-amatora justify-center-amatora mt-6-amatora">
              <a href="{{ block.settings.cta_link }}" class="btn-primary-amatora btn-block-amatora">
                <span class="btn-label">{{ block.settings.cta_text }}</span>
              </a>
            </div>
          {%- endif -%}

        </div>
      {%- endfor -%}

    </div>
  </div>

</div>

<style>
  /* Scope obligatorio: #{{ sid }}. Solo lo que NO existe como utility. */
  #{{ sid }} .nombre-am__media { aspect-ratio: 4/3; }

  {%- if section.settings.bg_color != blank -%}
    #{{ sid }} { background: {{ section.settings.bg_color }}; }
  {%- endif -%}
</style>

{%- endif -%}

{% schema %}
{
  "name": "Nombre Amatora",
  "class": "section-nombre-amatora",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título de la sección"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "visible_desktop",
      "label": "Slides visibles (desktop)",
      "min": 1, "max": 6, "step": 1, "default": 3
    },
    {
      "type": "range",
      "id": "visible_tablet",
      "label": "Slides visibles (tablet)",
      "min": 1, "max": 4, "step": 1, "default": 2
    },
    {
      "type": "text",
      "id": "visible_mobile",
      "label": "Slides visibles (móvil)",
      "default": "1.2",
      "info": "Permite decimales (ej: 1.2 muestra 1 entero + asomo del siguiente)"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Aria-label (accesibilidad)"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Imagen (800×600 recomendado)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo (SEO)",
          "info": "Descripción para lectores de pantalla y SEO"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Link del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nombre Amatora",
      "category": "Amatora",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
